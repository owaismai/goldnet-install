# Copy to .env.local to override. These values end up in the public JS bundle: NOT secret.
VITE_WHATSAPP_NUMBER=27689197093
# Google address search: public key, restrict it to your site + Maps JavaScript API + Places API (New). Empty = off.
VITE_GOOGLE_MAPS_API_KEY=
# URL path the site is served from. "/" for dev or a custom domain, "/<repo>/" for GitHub Pages.
BASE_PATH=/
